<td>
  <AuLinkExternal
    title={{this.agentLink}}
    href={{this.agentLink}}
    @icon="link-external"
    @newTab={{true}}
    @iconAlignment="right"
  >
    {{prefixed-url this.agentName}}
  </AuLinkExternal>
</td>
<td>
  <div class="au-u-flex au-u-flex--between">
    <DecisionLink @expression={{@annotation.targetModel}} />
    <AuButton
      class="au-u-flex-shrink-0 au-u-padding-right-none"
      @skin="naked"
      @icon="document"
      @hideText={{true}}
      {{on "click" this.openDecisionText}}
    >Show Text</AuButton>
  </div>
  {{#if this.showContent}}
    <AuCard
      class="expression-content au-u-padding-small"
      {{on-click-outside
        this.hideDecisionText
        exceptSelector=".expression-content"
      }}
      @shadow="true"
    >
      <AuButton
        class="close-button"
        @skin="link-secondary"
        @icon="x"
        @hideText={{true}}
        {{on "click" this.hideDecisionText}}
      >Close</AuButton>
      <div>
        {{@annotation.targetModel.trimmedExpressionContent}}
      </div>

    </AuCard>
  {{/if}}
</td>
<td>
  <AuLinkExternal
    @skin="link"
    href={{this.valueLink}}
    class="inline-block multi-line user-selectable"
    title={{this.fullValue}}
  >
    {{this.value}}
  </AuLinkExternal>
</td>
{{#if @showImpact}}
  <td class="au-u-text-center">
    {{#if this.impact}}
      <AuPill @skin={{this.impactSkin}} title={{concat "impact: " this.impact}}>
        {{this.impactText}}
      </AuPill>
    {{/if}}
  </td>
{{/if}}
<td>
  <ValidationThumbs @annotation={{@annotation}} />
</td>
{{yield}}{{yield}}