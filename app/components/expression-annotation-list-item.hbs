<td>
  <DecisionLink @expression={{@annotation.targetModel}} />
</td>
<td>
  <AuLinkExternal
    @skin="link"
    href={{this.valueLink}}
    class="inline-block multi-line user-selectable"
    title={{this.fullValue}}
  >
    {{this.value}}
  </AuLinkExternal>
</td>
{{#if @showImpact}}
  <td class="au-u-text-center">
    {{#if this.impact}}
      <AuPill @skin={{this.impactSkin}} title={{concat "impact: " this.impact}}>
        {{this.impactText}}
      </AuPill>
    {{/if}}
  </td>
{{/if}}
<td>
  <ValidationThumbs
    @annotation={{@annotation}}
    @allowCorrection={{true}}
    @conceptSchemeId={{@conceptSchemeId}}
  />
</td>
{{yield}}{{yield}}
