<td>
  {{#if this.agentLink}}
    <AuLinkExternal
      title={{this.agentLink}}
      href={{this.agentLink}}
      @icon="link-external"
      @newTab={{true}}
      @iconAlignment="right"
    >
      {{prefixed-url this.agentName}}
    </AuLinkExternal>
  {{else}}
    {{prefixed-url this.agentName}}
  {{/if}}
</td>
<td>
  <DecisionLink @expression={{@annotation.targetModel}} />
</td>
<td>
  <AuLinkExternal
    @skin="link"
    href={{this.valueLink}}
    class="inline-block multi-line user-selectable"
    title={{this.fullValue}}
  >
    {{this.value}}
  </AuLinkExternal>
</td>
{{#if @showImpact}}
  <td class="au-u-text-center">
    {{#if this.impact}}
      <AuPill
        @skin={{this.impactSkin}}
        title={{t "expression-annotation-impact" impact=this.impact}}
      >
        {{this.impactText}}
      </AuPill>
    {{/if}}
  </td>
{{/if}}
<td>
  <ValidationThumbs
    @annotation={{@annotation}}
    @allowCorrection={{true}}
    @conceptSchemeId={{@conceptSchemeId}}
  />
</td>
{{yield}}{{yield}}
