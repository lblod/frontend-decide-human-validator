<div class="au-u-flex au-u-flex--spaced">
  <AuButton @skin="naked" {{on "click" this.approve}}>
    <VoteThumbsUpIcon @fill={{if this.approved "#0055CC"}} />
    <AuPill @skin="success">{{this.approvedCount}}</AuPill>
  </AuButton>
  <AuButton @skin="naked" {{on "click" this.reject}}>
    <AuPill @skin="warning">{{this.rejectedCount}}</AuPill>
    <VoteThumbsDownIcon @fill={{if this.rejected "#0055CC"}} />
  </AuButton>
</div>
<AuModal
  @modalOpen={{this.modalOpen}}
  @closeModal={{this.cancelReject}}
  @overflow={{true}}
  @initialFocus="#au-confirm-reject"
>
  <:title>
    Voeg correcties toe
  </:title>
  <:body>
    {{#each this.corrections as |correction index|}}
      <div class="au-u-margin-bottom au-u-flex au-u-width-full">
        <div class="au-u-flex-grow">
          <AuLabel>Concept</AuLabel>
          <PowerSelect
            @searchEnabled={{true}}
            @searchField="prefLabel"
            @options={{this.concepts}}
            @selected={{correction.concept}}
            @onChange={{fn this.editCorrectionConcept index}}
            @renderInPlace={{true}}
            as |option|
          >
            {{option.prefLabel}}
          </PowerSelect>
          <AuLabel>Impact</AuLabel>
          <PowerSelect
            @searchEnabled={{true}}
            @searchField="prefLabel"
            @options={{this.impacts}}
            @selected={{correction.impact}}
            @onChange={{fn this.editCorrectionImpact index}}
            @renderInPlace={{true}}
            as |option|
          >
            {{option.prefLabel}}
          </PowerSelect>
        </div>
        <AuButton
          @skin="naked"
          @icon="x"
          @hideText="true"
          {{on "click" (fn this.removeCorrection index)}}
        >Remove</AuButton>
      </div>
    {{else}}
      Nog geen correcties toegevoegd
    {{/each}}
    <div class="au-u-margin-top">
      <AuButton {{on "click" this.addCorrection}} @icon="plus">Correctie toevoegen</AuButton>
    </div>

    {{#if this.hasDuplicateCorrection}}
      <AuAlert @skin="error" class="au-u-margin-top">
        The same concept is used multiple times as a correction.
      </AuAlert>
    {{/if}}
  </:body>
  <:footer>
    <AuButton
      id="au-confirm-reject"
      @disabled={{this.hasDuplicateCorrection}}
      {{on "click" this.confirmReject}}
    >Bevestigen</AuButton>
    <AuButton
      @skin="secondary"
      {{on "click" this.cancelReject}}
    >Annuleren</AuButton>
  </:footer>

</AuModal>
{{yield}}