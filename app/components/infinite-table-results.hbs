{{#if @showPageCount}}
  <AuToolbar @size="medium" as |Group|>
    <Group />
    <Group>
      Showing
      {{this.items.length}}
      of
      {{this.totalCount}}
    </Group>
  </AuToolbar>
{{/if}}
<AuDataTable
  @content={{this.items}}
  @noDataMessage={{@noDataMessage}}
  @page={{this.page}}
  @hidePagination={{true}}
  as |t|
>
  <t.content as |c|>
    <c.header>
      {{yield to="headers"}}
    </c.header>
    {{#if (and this.fetchResults.isRunning (eq this.items.length 0))}}
      <tr>
        <td colspan="100%">
          <div class="au-u-flex au-u-flex--center">
            <AuLoader @hideMessage={{not @loadingMessage}} @centered={{true}}>
              <p class="au-u-muted au-u-h6">{{@loadingMessage}}</p>
            </AuLoader>
          </div>
        </td>
      </tr>

    {{else}}
      <c.body as |row|>
        {{yield row to="row"}}
        {{#if (eq row this.lastVisibleItemTrigger)}}
          {{! template-lint-disable no-inline-styles }}
          <td style="padding:0;border:0;" {{this.observeIfNearEnd}}></td>
        {{/if}}
      </c.body>
    {{/if}}
  </t.content>
</AuDataTable>
{{#if (and this.fetchResults.isRunning (not (eq this.items.length 0)))}}
  <div class="au-u-flex au-u-flex--center">
    <AuLoader @hideMessage={{true}} @centered={{true}} />
  </div>
{{/if}}