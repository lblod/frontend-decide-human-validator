<AuTooltip @placement="top" as |tooltip|>
  <AuLinkExternal
    {{tooltip.target}}
    href={{this.typeLink}}
    newTab={{true}}
    @icon="link-external"
    @iconAlignment="right"
  >
    {{this.typeText}}
  </AuLinkExternal>
  <tooltip.Content>
    {{this.typeComment}}
    {{#if this.exampleText}}
      <br />
      {{this.exampleText}}
    {{/if}}
  </tooltip.Content>
  {{yield}}
</AuTooltip>