{{#if this.linkLink}}
  <AuTooltip @placement="top" as |tooltip|>
    <AuLinkExternal
      {{tooltip.target}}
      href={{this.linkLink}}
      newTab={{true}}
      @icon="link-external"
      @iconAlignment="right"
    >
      {{prefixed-url @annotation.link}}
    </AuLinkExternal>
    <tooltip.Content>
      {{this.linkComment}}
    </tooltip.Content>
  </AuTooltip>
{{else}}
  <span>None</span>
{{/if}}
{{yield}}