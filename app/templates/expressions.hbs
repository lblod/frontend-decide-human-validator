{{page-title (t "expressions-title")}}

<AuMainContainer class="au-u-height-full" as |main|>
  <main.sidebar>
    <div class="au-c-sidebar">
      <div class="au-c-sidebar__content au-u-padding au-o-flow--small">
        <AuHeading
          @skin={{3}}
          @level={{3}}
          class="au-u-margin-top-none au-u-margin-bottom-small"
        >
          {{t "expressions-filter-decisions"}}
        </AuHeading>
        <div>
          <AuLabel for="decision-passed-by">
            {{t "filter-local-authority"}}
          </AuLabel>
          <PowerSelect
            id="decision-passed-by"
            @searchEnabled={{true}}
            @searchField="prefLabel"
            @search={{this.searchMunicipality}}
            @options={{@model.municipalities}}
            @selected={{this.selectedMunicipality}}
            @onChange={{this.changeSelectedMunicipality}}
            @renderInPlace={{true}}
            as |option|
          >
            {{option.prefLabel}}
          </PowerSelect>
        </div>
        <div>
          <AuLabel for="decision-passed-by">
            {{t "filter-title"}}
          </AuLabel>
          <AuInput
            @width="block"
            id="title-search"
            value={{this.search}}
            {{on "input" (perform this.searchTitle)}}
          />
        </div>
        <div>
          <AuLabel for="expression-ai-model">
            {{t "validate-ai-component"}}
          </AuLabel>
          <PowerSelectMultiple
            id="expression-ai-model"
            @searchEnabled={{true}}
            @searchField="value"
            @options={{@model.aiModelOptions}}
            @selected={{this.selectedAiModels}}
            @onChange={{this.changeSelectedAiModels}}
            @renderInPlace={{true}}
            as |option|
          >
            {{prefixed-url option.value}}
          </PowerSelectMultiple>
        </div>
        <div>
          <AuLabel for="expression-predicate">
            {{t "expressions-link"}}
          </AuLabel>
          <PowerSelectMultiple
            id="expression-predicate"
            @searchEnabled={{true}}
            @searchField="value"
            @options={{@model.predicateOptions}}
            @selected={{this.selectedPredicates}}
            @onChange={{this.changeSelectedPredicates}}
            @renderInPlace={{true}}
            as |option|
          >
            {{prefixed-url option.value}}
          </PowerSelectMultiple>
        </div>
        <div>
          <AuLabel for="expression-value-type">
            {{t "expressions-type"}}
          </AuLabel>
          <PowerSelectMultiple
            id="expression-value-type"
            @searchEnabled={{true}}
            @searchField="value"
            @options={{@model.typeOptions}}
            @selected={{this.selectedTypes}}
            @onChange={{this.changeSelectedTypes}}
            @renderInPlace={{true}}
            as |option|
          >
            {{prefixed-url option.value}}
          </PowerSelectMultiple>
        </div>
        <div class="au-u-margin-top-small au-u-text-right">
          <AuButton @icon="x" @skin="naked" {{on "click" this.resetFilter}}>
            {{t "filter-reset"}}
          </AuButton>
        </div>
      </div>
    </div>
  </main.sidebar>
  <main.content>
    <AuBodyContainer id="content" @scroll={{true}}>
      <AuHeading size="large" class="au-u-padding">
        {{t "validate-ai-annotations"}}
      </AuHeading>
      <AuDataTable
        @content={{@model.expressions}}
        @noDataMessage={{t "general-no-annotated-decisions"}}
        @page={{this.page}}
        @size={{this.size}}
        as |table|
      >
        <table.content as |c|>
          <c.header>
            <th>{{t "expressions-expression"}}</th>
            <th>{{t "expressions-organization"}}</th>
            <th>{{t "expressions-annotations"}}</th>
            <th>{{t "expressions-action"}}</th>
          </c.header>
          <c.body as |expression|>
            <td class="ellipsis">
              <AuLink
                title={{expression.title}}
                @model={{expression.id}}
                @route="validate"
                @icon="pencil"
                @iconAlignment="right"
                @query={{@model.commonDetailPageParams}}
              >
                <span>{{or
                    expression.title
                    expression.model.fallbackTitle
                  }}</span>
              </AuLink>
            </td>
            <td>
              {{#each expression.model.realizes.passedBy as |passed_by|}}
                {{passed_by.prefLabel}}
              {{else}}
                /
              {{/each}}
            </td>
            <td>{{or expression.annotationReviewedCount 0}}/{{or
                expression.annotationCount
                0
              }}</td>
            <td>
              {{#if (await expression.model.accessLink)}}
                <AuLinkExternal
                  @icon="link-external"
                  @iconAlignment="right"
                  @newTab={{true}}
                  href={{await expression.model.accessLink}}
                >
                  {{t "expressions-view-decision"}}
                </AuLinkExternal>
              {{else}}
                <span>{{t "expressions-no-decision-link"}}</span>
              {{/if}}
            </td>
          </c.body>
        </table.content>
      </AuDataTable>
      {{outlet}}
    </AuBodyContainer>
  </main.content>
</AuMainContainer>
