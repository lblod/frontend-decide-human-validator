{{page-title "Expressions"}}

<AuMainContainer class="au-u-height-full" as |main|>
  <main.sidebar>
    <div class="au-c-sidebar">
      <div class="au-c-sidebar__content au-u-padding au-o-flow--small">
        <AuHeading
          @skin={{3}}
          @level={{3}}
          class="au-u-margin-top-none au-u-margin-bottom-small"
        >
          Filter decisions
        </AuHeading>
        <div>
          <AuLabel for="decision-passed-by">
            Local authority
          </AuLabel>
          <PowerSelect
            id="decision-passed-by"
            @searchEnabled={{true}}
            @searchField="prefLabel"
            @search={{this.searchMunicipality}}
            @options={{@model.municipalities}}
            @selected={{this.selectedMunicipality}}
            @onChange={{this.changeSelectedMunicipality}}
            @renderInPlace={{true}}
            as |option|
          >
            {{option.prefLabel}}
          </PowerSelect>
        </div>
        <div>
          <AuLabel for="decision-passed-by">
            Title
          </AuLabel>
          <AuInput
            @width="block"
            id="title-search"
            value={{this.search}}
            {{on "input" (perform this.searchTitle)}}
          />
        </div>
        <div>
          <AuLabel for="expression-ai-model">
            AI model
          </AuLabel>
          <PowerSelectMultiple
            id="expression-ai-model"
            @searchEnabled={{true}}
            @searchField="value"
            @options={{@model.aiModelOptions}}
            @selected={{this.selectedAiModels}}
            @onChange={{this.changeSelectedAiModels}}
            @renderInPlace={{true}}
            as |option|
          >
            {{prefixed-url option.value}}
          </PowerSelectMultiple>
        </div>
        <div>
          <AuLabel for="expression-predicate">
            Link
          </AuLabel>
          <PowerSelectMultiple
            id="expression-predicate"
            @searchEnabled={{true}}
            @searchField="value"
            @options={{@model.predicateOptions}}
            @selected={{this.selectedPredicates}}
            @onChange={{this.changeSelectedPredicates}}
            @renderInPlace={{true}}
            as |option|
          >
            {{prefixed-url option.value}}
          </PowerSelectMultiple>
        </div>
        <div>
          <AuLabel for="expression-value-type">
            Type
          </AuLabel>
          <PowerSelectMultiple
            id="expression-value-type"
            @searchEnabled={{true}}
            @searchField="value"
            @options={{@model.typeOptions}}
            @selected={{this.selectedTypes}}
            @onChange={{this.changeSelectedTypes}}
            @renderInPlace={{true}}
            as |option|
          >
            {{prefixed-url option.value}}
          </PowerSelectMultiple>
        </div>
        <div class="au-u-margin-top-small au-u-text-right">
          <AuButton
            @icon="x"
            @skin="naked"
            {{on "click" this.resetFilter}}
          >Reset Filters</AuButton>
        </div>
      </div>
    </div>
  </main.sidebar>
  <main.content>
    <AuBodyContainer id="content" @scroll={{true}}>
      <AuHeading size="large" class="au-u-padding">Validate AI annotations</AuHeading>
      <InfiniteTableResults
        @initialState={{this._cachedInfiniteState}}
        @onItemsUpdated={{this.onItemsUpdated}}
        @noDataMessage="No annotated decisions found"
        @loadingMessage="Fetching annotated decisions"
        @size={{this.size}}
        @onLoadMore={{this.fetchExpressions}}
      >
        <:headers>
          <th>Expression</th>
          <th>Organization</th>
          <th>Annotations</th>
          <th>Action</th>
        </:headers>
        <:row as |expression|>
          <td class="ellipsis">
            <AuLink
              title={{expression.title}}
              @model={{expression.id}}
              @route="validate"
              @icon="pencil"
              @iconAlignment="right"
              @query={{@model.commonDetailPageParams}}
            >
              <span>{{or
                  expression.title
                  expression.model.fallbackTitle
                }}</span>
            </AuLink>
          </td>
          <td>
            {{#each expression.model.realizes.passedBy as |passed_by|}}
              {{passed_by.prefLabel}}
            {{else}}
              /
            {{/each}}
          </td>
          <td>{{or expression.annotationReviewedCount 0}}/{{or
              expression.annotationCount
              0
            }}</td>
          <td>
            {{#if (await expression.model.accessLink)}}
              <AuLinkExternal
                @icon="link-external"
                @iconAlignment="right"
                @newTab={{true}}
                href={{await expression.model.accessLink}}
              >
                View decision
              </AuLinkExternal>
            {{else}}
              <span>No decision link</span>
            {{/if}}
          </td>
        </:row>
      </InfiniteTableResults>
      {{outlet}}
    </AuBodyContainer>
  </main.content>
</AuMainContainer>