{{page-title (t "annotation-page-title")}}

<AuTable>
  <:title>{{t "annotation-title-geo"}}</:title>
  <:body>
    <tr>
      <td>{{t "annotation-resource-uuid"}}</td>
      <td>{{@model.annotation.id}}</td>
    </tr>
    <tr>
      <td>{{t "annotation-motivation"}}</td>
      <td>{{@model.annotation.motivatedBy}}</td>
    </tr>
    <tr>
      <td>{{t "annotation-confidence"}}</td>
      <td>{{@model.annotation.confidence}}</td>
    </tr>
  </:body>
</AuTable>

<AuTable>
  <:title>{{t "annotation-location-title"}}</:title>
  <:body>
    <tr>
      <td>{{t "annotation-location-label-column"}}</td>
      <td>{{@model.location.label}}</td>
    </tr>
    <tr>
      <td>{{t "annotation-location-match-column"}}</td>
      <td>
        {{#if @model.location.exactMatch}}
          <AuLinkExternal href={{@model.location.exactMatch}}>
            {{@model.location.exactMatch}}
          </AuLinkExternal>
        {{else}}
          {{t "general-not-applicable"}}
        {{/if}}
      </td>
    </tr>
  </:body>
</AuTable>

<AuTable>
  <:title>{{t "annotation-geometry-title"}}</:title>
  <:body>
    <tr>
      <td>{{t "annotation-geometry-coord"}}</td>
      <td>{{@model.geometry.asWKT}}</td>
    </tr>
    <tr>
      <td>{{t "annotation-geometry-map-column"}}</td>
      <td>
        <Leaflet @props={{@model.geometry.wgs84Coord}} />
      </td>
    </tr>
  </:body>
</AuTable>

{{outlet}}
