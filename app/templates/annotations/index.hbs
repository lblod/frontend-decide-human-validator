{{page-title (t "annotations-page-title")}}
<AuDataTable
  @content={{@model}}
  @noDataMessage={{t "general-no-annotated-data"}}
  @page={{this.page}}
  @size={{this.size}}
  as |table|
>
  <table.content as |c|>
    <c.header>
      <th>{{t "annotation-annotation"}}</th>
      <th>{{t "annotation-motivated-by"}}</th>
    </c.header>
    <c.body as |annotation|>
      <td>
        <AuLink @model={{annotation.id}} @route="annotations.annotation">
          {{annotation.id}}
        </AuLink>
      </td>
      <td>{{annotation.motivatedBy}}</td>
    </c.body>
  </table.content>
</AuDataTable>
{{outlet}}
