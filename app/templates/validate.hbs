{{page-title (t "validate-ai-annotations")}}

<AuToolbar @border="bottom" @size="small" @skin="tint">
  <nav aria-label="breadcrumbs" class="au-u-flex au-u-flex--between au-u-1-1">
    <ol
      class="au-c-list-horizontal au-c-list-horizontal--breadcrumbs au-u-margin-left-tiny au-u-flex--spaced-tiny"
    >
      <li class="au-c-list-horizontal__item">
        <AuLink
          @route="expressions"
          @icon="arrow-left"
          @query={{@model.commonDetailPageParams}}
        >
          {{t "validate-back-to-decision-list"}}
        </AuLink>
      </li>
      <li class="vertical-separator"></li>
      <li class="au-c-list-horizontal__item au-u-bold">
        {{@model.title}}
      </li>
    </ol>
  </nav>
</AuToolbar>
<AuMainContainer class="au-u-height-full" as |main|>
  <main.sidebar>
    <div class="au-c-sidebar">
      <div class="au-c-sidebar__content au-u-padding au-o-flow--small">
        <AuHeading
          @skin={{3}}
          @level={{3}}
          class="au-u-margin-top-none au-u-margin-bottom-small"
        >
          {{t "filter-annotations"}}
        </AuHeading>
        <div>
          <AuLabel for="expression-ai-model">
            {{t "validate-ai-component"}}
          </AuLabel>
          <PowerSelectMultiple
            id="expression-ai-model"
            @searchEnabled={{true}}
            @searchField="value"
            @options={{@model.aiModelOptions}}
            @selected={{this.selectedAiModels}}
            @onChange={{this.changeSelectedAiModels}}
            @renderInPlace={{true}}
            as |option|
          >
            {{prefixed-url option.value}}
          </PowerSelectMultiple>
        </div>
        <div>
          <AuLabel for="expression-predicate">
            {{t "expressions-link"}}
          </AuLabel>
          <PowerSelectMultiple
            id="expression-predicate"
            @searchEnabled={{true}}
            @searchField="value"
            @options={{@model.predicateOptions}}
            @selected={{this.selectedPredicates}}
            @onChange={{this.changeSelectedPredicates}}
            @renderInPlace={{true}}
            as |option|
          >
            {{prefixed-url option.value}}
          </PowerSelectMultiple>
        </div>
        <div>
          <AuLabel for="expression-value-type">
            {{t "expressions-type"}}
          </AuLabel>
          <PowerSelectMultiple
            id="expression-value-type"
            @searchEnabled={{true}}
            @searchField="value"
            @options={{@model.typeOptions}}
            @selected={{this.selectedTypes}}
            @onChange={{this.changeSelectedTypes}}
            @renderInPlace={{true}}
            as |option|
          >
            {{prefixed-url option.value}}
          </PowerSelectMultiple>
        </div>
        <div class="au-u-margin-top">
          <AuCheckbox
            @checked={{this.hideVoted}}
            @onChange={{this.toggleHideVoted}}
          >
            {{t "validate-hide-reviewed"}}
          </AuCheckbox>
        </div>
        <div class="au-u-margin-top-small au-u-text-right">
          <AuButton @icon="x" @skin="naked" {{on "click" this.resetFilter}}>
            {{t "filter-reset"}}
          </AuButton>
        </div>
      </div>
    </div>
  </main.sidebar>
  <main.content>
    <AuBodyContainer class="au-u-flex au-u-flex--row">
      <AuBodyContainer @scroll={{true}}>
        <div class="au-u-padding">
          <div
            class="au-u-padding au-u-padding-left-none au-u-padding-right-none au-u-flex au-u-flex--vertical-center au-u-flex--between"
          >
            <AuHeading @level={{1}} @skin={{1}}>
              {{t "validate-ai-annotations"}}
            </AuHeading>
          </div>
          <div class="au-o-box au-u-background-gray-100 au-u-padding-small">
            <AuHeading @level={{2}} @skin={{6}}>
              {{t "validate-decision"}}
            </AuHeading>
            <DecisionLink
              @expression={{@model.expression}}
              @title={{or @model.title @model.expression.fallbackTitle}}
            />
          </div>
        </div>
        <AuDataTable
          @content={{@model.annotations}}
          @noDataMessage={{t "general-no-annotated-decisions"}}
          @page={{this.page}}
          @size={{this.size}}
          as |table|
        >
          <table.content as |c|>
            <c.header>
              <th>{{t "validate-ai-component"}}</th>
              <th>{{t "expressions-link"}}</th>
              <th>{{t "expressions-type"}}</th>
              <th>{{t "validate-discovered-entity"}}</th>
              <th>{{t "validate-correct"}}</th>
            </c.header>
            <c.body as |annotation|>
              <AnnotationListItem
                @annotation={{annotation}}
                @onSelect={{this.selectAnnotation}}
              />
            </c.body>
          </table.content>
        </AuDataTable>
        {{outlet}}
      </AuBodyContainer>

      {{#if this.selectedAnnotation}}
        <AnnotationLocation
          @expression={{@model.expression}}
          @annotation={{this.selectedAnnotation}}
          @location={{await this.selectedAnnotation.model.hasTarget.selector}}
          @onClose={{fn this.selectAnnotation null}}
        />
      {{/if}}
    </AuBodyContainer>
  </main.content>
</AuMainContainer>
