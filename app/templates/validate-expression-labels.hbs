{{page-title (t "validate-ai-annotations")}}

<AuMainContainer class="au-u-height-full" as |main|>
  <main.sidebar>
    <div class="au-c-sidebar">
      <div class="au-c-sidebar__content au-u-padding">
        <div>
          <AuLabel for="decision-passed-by">
            {{t "filter-local-authority"}}
          </AuLabel>
          <PowerSelect
            id="decision-passed-by"
            @searchEnabled={{true}}
            @searchField="prefLabel"
            @search={{this.searchMunicipality}}
            @options={{@model.municipalities}}
            @selected={{this.selectedMunicipality}}
            @onChange={{this.changeSelectedMunicipality}}
            @renderInPlace={{true}}
            as |option|
          >
            {{option.prefLabel}}
          </PowerSelect>
          {{#if this.canClearMunicipality}}
            <AuButton
              @skin="link"
              class="au-u-flex-shrink-0"
              {{on "click" this.clearMunicipality}}
            >
              {{t "filter-clear"}}
            </AuButton>
          {{/if}}
        </div>
        <div class="au-u-margin-top-small">
          <AuLabel for="title-search">
            {{t "filter-title"}}
          </AuLabel>
          <AuInput
            id="title-search"
            value={{this.search}}
            {{on "input" (perform this.searchTitle)}}
          />
          {{#if this.canClearTitle}}
            <AuButton
              @skin="link"
              class="au-u-flex-shrink-0"
              {{on "click" this.clearTitle}}
            >
              {{t "filter-clear"}}
            </AuButton>
          {{/if}}
        </div>
        <div class="au-u-margin-top-small">
          <AuLabel for="decision-year">
            {{t "filter-year"}}
          </AuLabel>
          <PowerSelect
            id="decision-year"
            @searchEnabled={{true}}
            @searchField="label"
            @options={{this.yearOptions}}
            @selected={{this.selectedYear}}
            @onChange={{this.changeYear}}
            @renderInPlace={{true}}
            as |option|
          >
            {{t option.label}}
          </PowerSelect>
        </div>

        <div class="au-u-margin-top">
          <AuToggleSwitch
            @checked={{this.hideVoted}}
            @onChange={{this.toggleHideVoted}}
            @disabled={{this.onResults}}
          >
            {{t "validate-hide-reviewed"}}
          </AuToggleSwitch>
        </div>
        {{#if this.showImpact}}
          <div class="au-u-margin-top">
            <AuLabel for="impact">
              {{t "filter-impact-type"}}
            </AuLabel>
            <AuRadioGroup
              @name="impact"
              @selected={{this.impact}}
              @onChange={{this.changeImpact}}
              as |Group|
            >
              {{#each this.impactOptions as |impact|}}
                <Group.Radio @value={{impact.value}}>
                  {{t impact.label}}
                </Group.Radio>
              {{/each}}
            </AuRadioGroup>
          </div>
        {{/if}}
        {{#if this.showCs}}
          <div class="au-u-margin-top">
            <AuLabel for="concept-scheme">
              {{t "filter-concept-scheme"}}
            </AuLabel>
            <PowerSelect
              id="concept-scheme"
              @searchEnabled={{true}}
              @searchField="prefLabel"
              @search={{this.searchConceptScheme}}
              @options={{@model.conceptSchemes}}
              @selected={{this.selectedConceptScheme}}
              @onChange={{this.changeSelectedConceptScheme}}
              @renderInPlace={{true}}
              as |option|
            >
              {{option.prefLabel}}
            </PowerSelect>
          </div>
        {{/if}}
        {{#if @model.concepts}}
          <div class="au-u-margin-top">
            <div class="au-u-flex">
              <AuLabel for="concept-scheme">
                {{this.selectedConceptScheme.prefLabel}}
              </AuLabel>

              {{#if this.canDeselectAllConcepts}}
                <AuButton
                  @skin="link"
                  {{on "click" this.deselectAllConcepts}}
                  class="au-u-flex-shrink-0"
                >
                  {{t "filter-deselect-all"}}
                </AuButton>
              {{/if}}
              {{#if this.canSelectAllConcepts}}
                <AuButton
                  @skin="link"
                  {{on "click" this.selectAllConcepts}}
                  class="au-u-flex-shrink-0"
                >
                  {{t "filter-select-all"}}
                </AuButton>
              {{/if}}
            </div>
            <ul>
              {{#each @model.concepts as |concept|}}
                <li class="au-u-padding-tiny au-u-padding-top-none">
                  <div class="au-u-flex">
                    <AuCheckbox
                      @name={{concept.label}}
                      @value={{concept.id}}
                      @checked={{this.isSelected
                        @model.selectedConcepts
                        concept
                      }}
                      @onChange={{fn this.toggleConcept concept}}
                    >
                      {{if concept.notation (concat concept.notation ": ") ""}}
                      {{concept.label}}
                    </AuCheckbox>
                  </div>
                </li>
              {{/each}}
            </ul>
          </div>
        {{/if}}

        <div class="au-u-margin-top-small au-u-text-right">
          <AuButton @icon="x" @skin="naked" {{on "click" this.resetFilters}}>
            {{t "filter-reset"}}
          </AuButton>
        </div>
      </div>
    </div>
  </main.sidebar>
  <main.content>
    <AuBodyContainer id="content" @scroll={{true}}>
      <div class="au-u-flex au-u-height-full">
        <div class="au-u-flex-grow au-u-height-full">

          <div class="vertical-grow">
            <div
              class="au-u-padding au-u-flex au-u-flex--vertical-center au-u-flex--between au-u-1-1"
            >

              <div class="au-u-flex au-u-flex--between au-u-1-1">
                <AuHeading @level={{1}} @skin={{1}}>
                  {{t "validate-ai-annotations"}}
                </AuHeading>
                <FundedByDs4sscc />
              </div>
            </div>
            <AuTabs class="au-u-padding-left au-u-padding-right" as |Tab|>
              <Tab>
                <AuLink @route="validate-expression-labels.index">
                  {{t "validation-tab-validate"}}
                </AuLink>
              </Tab>
              <Tab>
                <AuLink @route="validate-expression-labels.results">
                  {{t "validation-results-button"}}
                </AuLink>
              </Tab>
            </AuTabs>
            {{outlet}}
          </div>
        </div>
        {{#if this.selectedAnnotation}}
          <AnnotationLocation
            @expression={{@model.expression}}
            @annotation={{this.selectedAnnotation}}
            @location={{await this.selectedAnnotation.hasTarget.selector}}
            @onClose={{fn this.selectAnnotation null}}
          />
        {{/if}}
      </div>
    </AuBodyContainer>
  </main.content>
</AuMainContainer>