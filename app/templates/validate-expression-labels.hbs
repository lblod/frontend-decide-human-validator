{{page-title "AI Annotatie Validator"}}

<AuMainContainer class="au-u-height-full" as |main|>
  <main.sidebar>
    <div class="au-c-sidebar">
      <div class="au-c-sidebar__content au-u-padding">
        <div>
          <AuLabel for="decision-passed-by-province">
            Provincie
          </AuLabel>
          <div class="au-u-flex">
            <div class="au-u-flex-grow">
              <PowerSelect
                id="decision-passed-by-province"
                @searchEnabled={{true}}
                @searchField="prefLabel"
                @search={{this.searchProvince}}
                @options={{@model.provinces}}
                @selected={{this.selectedProvince}}
                @onChange={{this.changeSelectedProvince}}
                @renderInPlace={{true}}
                as |option|
              >
                {{option.prefLabel}}
              </PowerSelect>
            </div>

            {{#if this.canClearProvince}}
              <AuButton
                @skin="link"
                {{on "click" this.clearProvince}}
                class="au-u-flex-shrink-0"
              >
                verwijder
              </AuButton>
            {{/if}}
          </div>
        </div>
        <div class="au-u-margin-top-small">
          <AuLabel for="decision-passed-by-municipality">
            Gemeente
          </AuLabel>
          <div class="au-u-flex">
            <div class="au-u-flex-grow">
              <PowerSelect
                id="decision-passed-by-municipality"
                @searchEnabled={{true}}
                @searchField="prefLabel"
                @search={{this.searchMunicipality}}
                @options={{@model.municipalities}}
                @selected={{this.selectedMunicipality}}
                @onChange={{this.changeSelectedMunicipality}}
                @renderInPlace={{true}}
                as |option|
              >
                {{option.prefLabel}}
              </PowerSelect>
            </div>
            {{#if this.canClearMunicipality}}
              <AuButton
                @skin="link"
                {{on "click" this.clearMunicipality}}
                class="au-u-flex-shrink-0"
              >
                verwijder
              </AuButton>
            {{/if}}
          </div>
        </div>
        <div class="au-u-margin-top-small">
          <AuLabel for="description-search">
            Beschrijving
          </AuLabel>
          <AuInput
            id="description-search"
            value={{this.search}}
            {{on "input" (perform this.searchDescription)}}
          />
          {{#if this.canClearSearch}}
            <AuButton
              @skin="link"
              {{on "click" this.clearSearch}}
              class="au-u-flex-shrink-0"
            >
              verwijder
            </AuButton>
          {{/if}}
        </div>
        {{#if this.showImpact}}
          <div class="au-u-margin-top">
            <AuLabel for="impact-filter">
              Impact type
            </AuLabel>
            <AuRadioGroup
              id="impact-filter"
              @name="impact"
              @selected={{this.impact}}
              @onChange={{this.changeImpact}}
              as |Group|
            >
              {{#each this.impactOptions as |impact|}}
                <Group.Radio
                  @value={{impact.value}}
                >{{impact.label}}</Group.Radio>
              {{/each}}
            </AuRadioGroup>
          </div>
        {{/if}}
        {{#if this.showCs}}
          <div class="au-u-margin-top">
            <AuLabel for="concept-scheme">
              Concept Schema
            </AuLabel>
            <PowerSelect
              id="concept-scheme"
              @searchEnabled={{true}}
              @searchField="prefLabel"
              @search={{this.searchConceptScheme}}
              @options={{@model.conceptSchemes}}
              @selected={{this.selectedConceptScheme}}
              @onChange={{this.changeSelectedConceptScheme}}
              @renderInPlace={{true}}
              as |option|
            >
              {{option.prefLabel}}
            </PowerSelect>
          </div>
        {{/if}}
        {{#if @model.concepts}}
          <div class="au-u-margin-top">
            <div class="au-u-flex">
              <AuLabel for="deselect-all">
                {{this.selectedConceptScheme.prefLabel}}
              </AuLabel>
              {{#if this.canDeselectAllConcepts}}
                <AuButton
                  id="deselect-all"
                  @skin="link"
                  {{on "click" this.deselectAllConcepts}}
                  class="au-u-flex-shrink-0"
                >
                  Deselecteer alles
                </AuButton>
              {{/if}}
              {{#if this.canSelectAllConcepts}}
                <AuButton
                  @skin="link"
                  {{on "click" this.selectAllConcepts}}
                  class="au-u-flex-shrink-0"
                >
                  Select all
                </AuButton>
              {{/if}}
            </div>
            <ul>
              {{#each @model.concepts as |concept|}}
                <li class="au-u-padding-tiny au-u-padding-top-none">
                  <div class="au-u-flex">
                    <AuCheckbox
                      @name={{concept.prefLabel}}
                      @value={{concept.id}}
                      @checked={{this.isSelected
                        @model.selectedConcepts
                        concept
                      }}
                      @onChange={{fn this.toggleConcept concept}}
                    >{{if
                        concept.notation
                        (concat concept.notation ": ")
                        ""
                      }}{{concept.prefLabel}}</AuCheckbox>
                  </div>

                </li>
              {{/each}}
            </ul>
          </div>
        {{/if}}

        <div class="au-u-margin-top-small au-u-text-right">
          <AuButton
            @icon="x"
            @skin="naked"
            {{on "click" this.resetFilters}}
          >Reset Filters</AuButton>
        </div>
      </div>
      {{outlet}}
    </div>
  </main.sidebar>
  <main.content>
    <AuBodyContainer id="content" @scroll={{true}}>
      <div class="au-u-flex au-u-height-full">
        <div class="au-u-flex-grow au-u-height-full">

          <div class="vertical-grow">
            <div
              class="au-u-padding au-u-flex au-u-flex--vertical-center au-u-flex--between"
            >
              <AuHeading @level={{1}} @skin={{1}}>AI Annotatie Validator</AuHeading>
              <AuToggleSwitch
                @checked={{this.hideVoted}}
                @onChange={{this.toggleHideVoted}}
              >Verberg reeds gevalideerde items</AuToggleSwitch>
            </div>
            <AuDataTable
              @content={{@model.annotations}}
              @noDataMessage="No annotated decisions found"
              @page={{this.page}}
              @size={{this.size}}
              as |t|
            >
              <t.content as |c|>
                <c.header>
                  <th>Actie</th>
                  <th>{{or
                      this.selectedConceptScheme.prefLabel
                      "Discovered entity"
                    }}</th>
                  {{#if this.showImpact}}
                    <th>Impact</th>
                  {{/if}}
                  <th>Is dit correct?</th>
                </c.header>
                <c.body as |annotation|>
                  <ExpressionAnnotationListItem
                    @showImpact={{this.showImpact}}
                    @annotation={{annotation}}
                    @conceptSchemeId={{this.model.conceptSchemeId}}
                  />
                </c.body>
              </t.content>
            </AuDataTable>
            {{outlet}}
          </div>
        </div>
        {{#if this.selectedAnnotation}}
          <AnnotationLocation
            @expression={{@model.expression}}
            @annotation={{this.selectedAnnotation}}
            @location={{await this.selectedAnnotation.hasTarget.selector}}
            @onClose={{fn this.selectAnnotation null}}
          />
        {{/if}}
      </div>
    </AuBodyContainer>
  </main.content>
</AuMainContainer>
