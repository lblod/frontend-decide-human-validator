{{page-title "AI Annotatie Validator"}}

<AuBodyContainer @scroll={{true}} class="au-u-padding">
  <AuHeading @skin={{1}} @level={{1}}>
    {{t "validate-ai-annotations"}}
  </AuHeading>
  <p>
    {{t "overview-description-prefix"}}
     <AuLinkExternal
      href="https://www.vlaanderen.be/publicaties/vlaams-klimaatadaptatieplan-vlaanderen-wapenen-tegen-de-klimaatverandering"
      @newTab={{true}}
    >
      {{t "overview-description-vap-link"}}
    </AuLinkExternal>.
    {{t "overview-description-suffix"}}
  </p>

    <div class="au-o-grid au-o-grid--tiny au-u-margin-top">
      {{#each @model.apps as |app|}}
        <div class="au-o-grid__item au-u-1-2">
          <AuCard class="au-u-padding" as |c|>
            <c.header>
              <AuHeading @skin={{4}} @level={{2}}>
                {{t app.title}}
              </AuHeading>
            </c.header>
            <c.content>
              {{t app.description}}
            </c.content>
            <c.footer>
              <AuLink @skin="button" @route={{app.route}} @query={{app.params}}>
                {{t "overview-start-validation"}}
              </AuLink>
            </c.footer>
          </AuCard>
        </div>
      {{/each}}
    </div>
  {{outlet}}
</AuBodyContainer>
